# Copy to .env and fill in. Never commit .env.

PORT=3001

# SQL Server (the same database the flows used to reach through the VPN)
DB_SERVER=your-sql-server-host
DB_PORT=1433
DB_NAME=ProjectPulse
DB_USER=pp_api_user
DB_PASSWORD=change-me
# true for Azure SQL / servers with a proper certificate; false is common for on-prem with a self-signed cert
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# Connection pool (this is what removes the old latency: connections stay open and are reused)
DB_POOL_MAX=20
DB_POOL_MIN=2

# Optional: serve the built frontend (../ProjectPulse_v7-main/v7/dist) from this same server
# so the app and API share one origin (no CORS needed).
FRONTEND_DIST=

# Max request body. Project documents travel as base64, so keep this generous.
BODY_LIMIT=50mb

# Outgoing email (audit mails, business-event mails, password-reset codes).
# Leave SMTP_HOST empty to keep email off — the app then logs each mail as "Failed" in the Notification Log.
# Microsoft 365: host smtp.office365.com, port 587, SMTP_SECURE=false, a mailbox with "Authenticated SMTP" enabled.
# Gmail: host smtp.gmail.com, port 587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Email option A (simplest): reuse the existing Power Automate mail flow, for mail ONLY.
# Paste the flow's HTTP trigger URL (the old /auditflow one). It contains a secret — keep it here, never in the frontend.
# The API machine needs normal internet access to reach it. If this is set, SMTP below is ignored.
MAIL_FLOW_URL=
